# Postgres (Neon). Get these from the Neon dashboard, or from Vercel's
# Storage > Neon integration, which sets them automatically on the linked project.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?channel_binding=require&sslmode=require"
# Direct (non-pooled) connection, used only by the Prisma CLI for migrations —
# Neon's pooled endpoint runs PgBouncer in transaction mode, which doesn't support
# the advisory locks Prisma Migrate needs.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Random secret used to sign admin session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-value"

# Used only by `prisma db seed` to create/update the first admin account.
# Change the password after first login.
SEED_ADMIN_EMAIL="admin@loja.com"
SEED_ADMIN_PASSWORD="TrocarSenha123!"

# Vercel Blob store token, used by /api/admin/upload for persistent product image
# storage. Create a Blob store for this project under Vercel dashboard > Storage,
# then either `vercel env pull` or copy the token here for local dev.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---- Meta Pixel (navegador) + Conversions API (servidor) ----
# Suporta VÁRIOS pixels em paralelo. Cada evento vai ao navegador (todos os pixels) e
# ao CAPI (todos os pixels) com o MESMO event_id, então o Meta deduplica por pixel e
# um reload nunca vira segunda conversão. (Substitui o antigo META_CAPI_ACCESS_TOKEN +
# o Pixel único do admin, que não são mais usados.)
#
# IDs dos pixels (não são segredo), separados por vírgula (quantos quiser):
# META_PIXEL_IDS="<pixel_id_1>,<pixel_id_2>,<pixel_id_3>"
#
# Tokens do CAPI — SENSITIVE, nunca comitar valor real. Formato pixelId:token, um par
# por pixel acima, separados por vírgula:
# META_CAPI_TOKENS="<pixel_id_1>:<token_1>,<pixel_id_2>:<token_2>,<pixel_id_3>:<token_3>"

# ---- Checkout embutido (PIX via BravoPay) ----
# O checkout agora roda DENTRO deste app, em /checkout/[orderNumber]. Não existe mais
# app externo: CHECKOUT_BASE_URL e CHECKOUT_WEBHOOK_SECRET ficaram obsoletos (podem ser
# removidos do projeto na Vercel).
#
# BravoPay (https://bravopay.club/docs) — SOMENTE no servidor. A chave NUNCA vai ao navegador.
# SENSITIVE — nunca comitar um valor real aqui.
# BRAVOPAY_API_KEY=
# Segredo de assinatura dos webhooks (painel BravoPay > Webhooks). Configure o webhook
# apontando para  https://<dominio>/api/webhooks/bravopay
# BRAVOPAY_WEBHOOK_SECRET=
# Opcionais:
# BRAVOPAY_BASE_URL=https://bravopay.club/api/v1
# BRAVOPAY_PRODUCT_ID=
# BRAVOPAY_MODE=mock   # gera um PIX fictício (não pagável) fora de produção, para testes

# ---- Abandoned-cart recovery email (Resend) ----
# Used by POST /api/admin/orders/[id]/recover-email. Create a free account at
# resend.com, add+verify the sending domain there (they give you DNS TXT/CNAME
# records — add those at your registrar), then create an API key.
# SENSITIVE — never commit a real value here.
# RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
# RESEND_FROM_EMAIL="Checkout <naoresponda@pagamento-shopee.com.br>"

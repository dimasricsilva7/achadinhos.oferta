# Postgres (Neon). Get these from the Neon dashboard, or from Vercel's
# Storage > Neon integration, which sets them automatically on the linked project.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?channel_binding=require&sslmode=require"
# Direct (non-pooled) connection, used only by the Prisma CLI for migrations —
# Neon's pooled endpoint runs PgBouncer in transaction mode, which doesn't support
# the advisory locks Prisma Migrate needs.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Random secret used to sign admin session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-value"

# Used only by `prisma db seed` to create/update the first admin account.
# Change the password after first login.
SEED_ADMIN_EMAIL="admin@loja.com"
SEED_ADMIN_PASSWORD="TrocarSenha123!"

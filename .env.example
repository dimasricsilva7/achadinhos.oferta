# Postgres (Neon). Get these from the Neon dashboard, or from Vercel's
# Storage > Neon integration, which sets them automatically on the linked project.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?channel_binding=require&sslmode=require"
# Direct (non-pooled) connection, used only by the Prisma CLI for migrations —
# Neon's pooled endpoint runs PgBouncer in transaction mode, which doesn't support
# the advisory locks Prisma Migrate needs.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Random secret used to sign admin session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-value"

# Used only by `prisma db seed` to create/update the first admin account.
# Change the password after first login.
SEED_ADMIN_EMAIL="admin@loja.com"
SEED_ADMIN_PASSWORD="TrocarSenha123!"

# Vercel Blob store token, used by /api/admin/upload for persistent product image
# storage. Create a Blob store for this project under Vercel dashboard > Storage,
# then either `vercel env pull` or copy the token here for local dev.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Meta Conversions API access token — SENSITIVE, never commit a real value here.
# Configured directly as a Vercel env var (Production, type "Sensitive"), not read
# from the admin panel. Used server-side only by src/lib/meta-capi.ts to send the
# "Purchase" event alongside the client-side Pixel for deduplication. The Pixel ID
# itself is NOT a secret and is configured in the admin (Settings > Marketing).
# META_CAPI_ACCESS_TOKEN=

# ---- checkout-bravopay integration ----
# Base URL of the standalone checkout app. POST /api/checkout/start appends
# ?pedido=<orderNumber> to this and redirects the customer there.
CHECKOUT_BASE_URL="https://checkout.seudominio.com.br"

# Shared secret checkout-bravopay sends in the X-Checkout-Secret header when calling
# POST /api/public/orders/[orderNumber]/confirm-payment to mark an order PAID once
# BravoPay confirms the PIX. Must match SITE_INTERNAL_SECRET over there exactly.
# SENSITIVE — never commit a real value here.
# CHECKOUT_WEBHOOK_SECRET=

// Prisma schema. Postgres (Neon), provisioned via the Vercel/Neon integration.
// Status fields stay String (not native enums) validated in code — see
// src/lib/constants.ts — so this schema also still works unchanged on SQLite for
// quick local prototyping if ever needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String?
  description      String?
  status           String   @default("DRAFT") // ProductStatus: DRAFT | ACTIVE | ARCHIVED

  sku String? @unique

  // Money stored as integer cents — never floating point.
  priceCents           Int
  compareAtPriceCents  Int?
  stock                Int @default(0)
  soldCount            Int @default(0)
  ratingAverage        Float @default(0)
  ratingCount          Int   @default(0)

  // Admin-authored bullets shown in the "Resumo das avaliações" block — free text,
  // not AI-generated. JSON-encoded array of { label, text }.
  reviewHighlights String?

  // Offer / countdown — the deadline is the single source of truth.
  // The client only ever renders (expiresAt - now); it never owns the timer.
  offerEnabled  Boolean   @default(false)
  offerExpiresAt DateTime?

  // Checkout integration: the real, verified contract with the external checkout
  // (pagseguropix.org / bravopay.club) is a pre-built static page per slug — there is
  // no discovered mechanism to pass product/price/qty via query params. So each
  // product (or variant) carries its own pre-built checkout URL.
  checkoutUrl String?

  deletedAt DateTime? // soft delete — orders must keep referencing the product

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  benefits       ProductBenefit[]
  addons         ProductAddon[]
  reviews        Review[]
  orders         Order[]

  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String  @default("")
  type      String  @default("image") // image | video
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

// Single variant dimension for MVP (e.g. "Cor"), grouped by `groupName`.
// Selecting a variant is the single source of truth for effective price/stock/image
// — see src/lib/pricing.ts:resolveEffectiveProduct().
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  groupName String // e.g. "Cor", "Modelo"
  label     String // e.g. "Preto"
  sku       String?
  imageUrl  String?

  priceCents Int? // overrides product.priceCents when set
  stock      Int  @default(0)

  checkoutUrl String? // overrides product.checkoutUrl when set
  sortOrder   Int     @default(0)

  orders Order[]

  @@index([productId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label     String
  value     String
  sortOrder Int    @default(0)

  @@index([productId])
}

model ProductBenefit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  icon      String @default("check")
  label     String
  sortOrder Int    @default(0)

  @@index([productId])
}

// "Seguros" / add-ons offered alongside the product (protection plans, extended
// warranty…), shown as checkboxes in the purchase bottom sheet. Priced in cents,
// never trusted from the client — see POST /api/checkout/start.
model ProductAddon {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  durationLabel String? // e.g. "12 meses"
  priceCents    Int
  sortOrder     Int     @default(0)
  enabled       Boolean @default(true)

  @@index([productId])
}

// Customer review — moderated via `status`. Not linked to Order (reviews are
// admin-curated content for this MVP, not verified-purchase records).
model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerName String
  avatarUrl    String?
  rating       Int // 1-5
  variantLabel String?
  comment      String
  helpfulCount Int      @default(0)
  status       String   @default("PUBLISHED") // ReviewStatus: PUBLISHED | HIDDEN
  createdAt    DateTime @default(now())

  media ReviewMedia[]

  @@index([productId])
  @@index([status])
}

model ReviewMedia {
  id           String @id @default(cuid())
  reviewId     String
  review       Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url          String
  type         String  @default("image") // image | video
  thumbnailUrl String?
  sortOrder    Int     @default(0)

  @@index([reviewId])
}

model Order {
  id           String  @id @default(cuid())
  orderNumber  String  @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity       Int
  unitPriceCents Int
  addonsCents    Int     @default(0)
  totalCents     Int
  addonsSnapshot String? // JSON-encoded [{ id, title, priceCents }] — audit of what was charged

  // PENDING = intent created, user sent to external checkout.
  // No webhook/API access into pagseguropix.org was found (see README) — status
  // beyond PENDING is set manually by an admin from confirmed payment evidence,
  // never inferred automatically.
  status String @default("PENDING") // OrderStatus

  checkoutUrl String // exact URL the customer was redirected to, for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

// Single-row (id = "singleton") global store configuration — see
// src/lib/settings-service.ts, which always upserts this row so callers never have to
// null-check it.
model Settings {
  id String @id @default("singleton")

  siteName        String  @default("Minha Loja")
  siteShortName   String?
  siteDescription String?
  logoUrl         String?
  faviconUrl      String?
  socialImageUrl  String?
  phone           String?
  whatsapp        String?
  supportEmail    String?
  supportContact  String? // legacy free-text contact field, kept for compatibility

  colorPrimary       String @default("#4338ca")
  colorPrimaryHover  String @default("#3730a3")
  colorBackground    String @default("#f5f6f8")
  colorSurface       String @default("#ffffff")
  colorText          String @default("#14161a")
  colorTextSecondary String @default("#6b7280")
  colorBorder        String @default("#e5e7eb")
  colorPrice         String @default("#dc2626")
  colorDiscount      String @default("#16a34a")
  colorOffer         String @default("#d97706")

  footerText  String?
  footerLinks String? // JSON-encoded [{ label, url }]

  checkoutTitle    String?
  checkoutSubtitle String?
  checkoutCta      String?

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String   // e.g. PRODUCT_CREATED, PRODUCT_UPDATED, ADMIN_LOGIN
  entity    String
  entityId  String?
  metadata  String?  // JSON-encoded, no secrets
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

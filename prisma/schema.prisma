// Prisma schema. Postgres (Neon), provisioned via the Vercel/Neon integration.
// Status fields stay String (not native enums) validated in code — see
// src/lib/constants.ts — so this schema also still works unchanged on SQLite for
// quick local prototyping if ever needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // Updated on every successful login (see src/app/api/admin/login/route.ts). Used
  // only to derive a real "Ativo há X min" readout on the storefront StoreInfo block
  // — never fabricated, and omitted from the UI entirely when null.
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String?
  description      String?
  status           String   @default("DRAFT") // ProductStatus: DRAFT | ACTIVE | ARCHIVED

  sku String? @unique

  // Money stored as integer cents — never floating point.
  priceCents           Int
  compareAtPriceCents  Int?
  stock                Int @default(0)
  soldCount            Int @default(0)
  ratingAverage        Float @default(0)
  ratingCount          Int   @default(0)

  // Admin-authored bullets shown in the "Resumo das avaliações" block — free text,
  // not AI-generated. JSON-encoded array of { label, text }.
  reviewHighlights String?

  // Offer / countdown — the deadline is the single source of truth.
  // The client only ever renders (expiresAt - now); it never owns the timer.
  offerEnabled  Boolean   @default(false)
  offerExpiresAt DateTime?

  // Decorative offer chips shown as a row of outline pills below the price
  // (e.g. "Compre R$100 e ganhe R$1 off"). Purely informational copy — no coupon
  // engine, no discount rule evaluated from this. JSON-encoded array of { label }.
  offerChips String?

  // Shows a small "Oficial" badge before the product name. Generic label, not tied
  // to any external brand/marketplace program.
  officialBadge Boolean @default(false)

  // Shipping/delivery display block — free-text, admin-authored. No real freight
  // calculation happens here (see README roadmap); it's presentational copy only,
  // never used to compute price or affect checkout.
  shippingEnabled             Boolean @default(true)
  shippingDeliveryText        String? // e.g. "Chega entre 13 e 15/ago"
  shippingFree                Boolean @default(true)
  shippingOriginalPriceCents  Int?
  shippingFinalPriceCents     Int? // 0 = grátis com cupom

  // Checkout integration: normally left empty — POST /api/checkout/start builds the
  // real checkout URL itself from env.CHECKOUT_BASE_URL + the generated orderNumber
  // (see that route), and checkout-bravopay fetches product/price live from
  // GET /api/public/orders/[orderNumber]. This field only exists as a per-product (or
  // per-variant) override, for the rare case a specific product needs a different
  // checkout destination.
  checkoutUrl String?

  deletedAt DateTime? // soft delete — orders must keep referencing the product

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  benefits       ProductBenefit[]
  addons         ProductAddon[]
  reviews        Review[]
  orders         Order[]

  @@index([status])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String  @default("")
  type      String  @default("image") // image | video
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

// Single variant dimension for MVP (e.g. "Cor"), grouped by `groupName`.
// Selecting a variant is the single source of truth for effective price/stock/image
// — see src/lib/pricing.ts:resolveEffectiveProduct().
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  groupName String // e.g. "Cor", "Modelo"
  label     String // e.g. "Preto"
  sku       String?
  imageUrl  String?

  priceCents Int? // overrides product.priceCents when set
  stock      Int  @default(0)

  checkoutUrl String? // overrides product.checkoutUrl when set
  sortOrder   Int     @default(0)

  orders Order[]

  @@index([productId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label     String
  value     String
  sortOrder Int    @default(0)

  @@index([productId])
}

model ProductBenefit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  icon      String @default("check")
  label     String
  sortOrder Int    @default(0)

  @@index([productId])
}

// "Seguros" / add-ons offered alongside the product (protection plans, extended
// warranty…), shown as checkboxes in the purchase bottom sheet. Priced in cents,
// never trusted from the client — see POST /api/checkout/start.
model ProductAddon {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  durationLabel String? // e.g. "12 meses"
  priceCents    Int
  sortOrder     Int     @default(0)
  enabled       Boolean @default(true)

  @@index([productId])
}

// Customer review — moderated via `status`. Not linked to Order (reviews are
// admin-curated content for this MVP, not verified-purchase records).
model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerName String
  avatarUrl    String?
  rating       Int // 1-5
  variantLabel String?
  comment      String
  helpfulCount Int      @default(0)
  status       String   @default("PUBLISHED") // ReviewStatus: PUBLISHED | HIDDEN
  createdAt    DateTime @default(now())

  media ReviewMedia[]

  @@index([productId])
  @@index([status])
}

model ReviewMedia {
  id           String @id @default(cuid())
  reviewId     String
  review       Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url          String
  type         String  @default("image") // image | video
  thumbnailUrl String?
  sortOrder    Int     @default(0)

  @@index([reviewId])
}

model Order {
  id           String  @id @default(cuid())
  orderNumber  String  @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity       Int
  unitPriceCents Int
  addonsCents    Int     @default(0)
  totalCents     Int
  addonsSnapshot String? // JSON-encoded [{ id, title, priceCents }] — audit of what was charged

  // PENDING = intent created, user sent to the checkout (checkout-bravopay).
  // PAID is set automatically by POST /api/public/orders/[orderNumber]/confirm-payment,
  // called server-to-server by checkout-bravopay once BravoPay confirms the PIX —
  // see that route for the shared-secret check. Any status past PAID (PROCESSING,
  // SHIPPED, ...) is still a manual admin action.
  status String @default("PENDING") // OrderStatus

  checkoutUrl String // exact URL the customer was redirected to, for audit

  // Filled in by confirm-payment once the customer pays — checkout-bravopay collects
  // these on its own form (this project never renders them) since the gateway's
  // native checkout had no address field, which was suspected to be costing sales.
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerCpf     String?
  shippingAddress String? // JSON-encoded { cep, street, number, complement, neighborhood, city, state }

  // BravoPay transaction id (tx_xxx), set by confirm-payment — useful for support
  // lookups against the BravoPay dashboard.
  gatewayTransactionId String?
  paidAt               DateTime?

  // Set once the Meta Conversions API "Purchase" event for this order is sent
  // successfully from /api/meta/purchase — lets that route be idempotent (a page
  // reload on /obrigado never double-fires the server-side event) without needing a
  // separate events table. Null = never sent.
  metaPurchaseEventSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

// Single-row (id = "singleton") global store configuration — see
// src/lib/settings-service.ts, which always upserts this row so callers never have to
// null-check it.
model Settings {
  id String @id @default("singleton")

  siteName        String  @default("Minha Loja")
  siteShortName   String?
  siteDescription String?
  logoUrl         String?
  faviconUrl      String?
  socialImageUrl  String?
  phone           String?
  whatsapp        String?
  supportEmail    String?
  supportContact  String? // legacy free-text contact field, kept for compatibility

  colorPrimary       String @default("#F2790F")
  colorPrimaryHover  String @default("#D6650A")
  colorBackground    String @default("#f5f6f8")
  colorSurface       String @default("#ffffff")
  colorText          String @default("#14161a")
  colorTextSecondary String @default("#6b7280")
  colorBorder        String @default("#e5e7eb")
  colorPrice         String @default("#dc2626")
  colorDiscount      String @default("#16a34a")
  colorOffer         String @default("#E8590C")

  footerText  String?
  footerLinks String? // JSON-encoded [{ label, url }]

  checkoutTitle    String?
  checkoutSubtitle String?
  checkoutCta      String?

  // Meta Pixel ID — public identifier (already shipped in browser HTML on every
  // page once configured), not a secret. Safe to show as-is in the admin. The
  // matching Conversions API access token is a real secret and is read only from
  // process.env.META_CAPI_ACCESS_TOKEN (Vercel env var), never stored here.
  metaPixelId String?

  // "Store info" block — this is a single-store project (no multi-vendor model), so
  // these describe the store as a whole and render on every product page, sourced
  // from this singleton rather than per-product data.
  storeLogoUrl              String?
  storeRatingAverage        Float    @default(0)
  storeRatingCount          Int      @default(0)
  // If null, product count is computed dynamically (count of ACTIVE, non-deleted
  // products) instead of asking the admin to keep a number in sync by hand.
  storeProductCount         Int?
  storeResponseRatePercent  Int      @default(100)
  // Free-text badge label (e.g. "Indicado") — configurable, never hardcoded copy.
  storeBadgeLabel           String?
  storeBadgeEnabled         Boolean  @default(false)
  // JSON-encoded array of Product ids, admin-picked, in display order, for the
  // "Produtos da mesma loja" carousel. Empty/null falls back to auto-picking other
  // active products by soldCount.
  storeRelatedProductIds    String?

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String   // e.g. PRODUCT_CREATED, PRODUCT_UPDATED, ADMIN_LOGIN
  entity    String
  entityId  String?
  metadata  String?  // JSON-encoded, no secrets
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
